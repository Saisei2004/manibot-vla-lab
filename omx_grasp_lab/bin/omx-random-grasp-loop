#!/usr/bin/env python3
import os
import signal
import subprocess
import sys
import time


def run(cmd, check=True):
    print("+", cmd, flush=True)
    return subprocess.run(["bash", "-lc", f"source /opt/ros/jazzy/setup.bash; {cmd}"], check=check)


def terminate(proc):
    if proc.poll() is not None:
        return
    try:
        os.killpg(proc.pid, signal.SIGTERM)
        proc.wait(timeout=8)
    except Exception:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except Exception:
            pass


def main():
    count = None
    if len(sys.argv) > 1:
        count = int(sys.argv[1])

    i = 0
    while count is None or i < count:
        i += 1
        print(f"\n=== random grasp trial {i} ===", flush=True)
        run("omx-randomize-object")

        launch = subprocess.Popen(
            ["bash", "-lc", "source /opt/ros/jazzy/setup.bash; ros2 launch open_manipulator_bringup open_manipulator_x_gazebo.launch.py world:=$HOME/robot_ws/worlds/omx_grasp_lab"],
            preexec_fn=os.setsid,
        )
        try:
            print("waiting for Gazebo/controllers...", flush=True)
            time.sleep(16)
            run("omx-random-grasp --hold 3")
        finally:
            print("resetting world...", flush=True)
            terminate(launch)
            time.sleep(3)


if __name__ == "__main__":
    main()
