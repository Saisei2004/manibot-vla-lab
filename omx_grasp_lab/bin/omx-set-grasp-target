#!/usr/bin/env python3
import json
import math
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

if len(sys.argv) != 3:
    raise SystemExit("usage: omx-set-grasp-target RADIUS_M THETA_DEG")

radius = float(sys.argv[1])
theta = math.radians(float(sys.argv[2]))
x = radius * math.cos(theta)
y = radius * math.sin(theta)
z = 0.035
yaw = theta

home = Path.home()
world_path = home / "robot_ws/worlds/omx_grasp_lab.sdf"
target_path = home / ".ros/omx_grasp_target.json"

tree = ET.parse(world_path)
root = tree.getroot()
for model in root.findall(".//model"):
    if model.attrib.get("name") == "grasp_cube":
        pose = model.find("pose")
        if pose is None:
            pose = ET.SubElement(model, "pose")
        pose.text = f"{x:.4f} {y:.4f} {z:.4f} 0 0 {yaw:.4f}"
        break
else:
    raise SystemExit("grasp_cube not found in world")

tree.write(world_path, encoding="utf-8", xml_declaration=True)
target_path.parent.mkdir(parents=True, exist_ok=True)
target_path.write_text(
    json.dumps({"x": x, "y": y, "z": z, "yaw": yaw, "radius": radius, "theta": theta}, indent=2) + "\n"
)
print(f"target r={radius:.3f} theta={math.degrees(theta):.1f}deg x={x:.3f} y={y:.3f}")
