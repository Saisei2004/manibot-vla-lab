#!/usr/bin/env bash
set -e
source /opt/ros/jazzy/setup.bash
ros2 action send_goal /arm_controller/follow_joint_trajectory control_msgs/action/FollowJointTrajectory "{trajectory: {joint_names: [joint1, joint2, joint3, joint4], points: [{positions: [0.0, 0.11, 0.82, -0.93], time_from_start: {sec: 3, nanosec: 0}}]}}"
